# Security headers for every response. Served by Cloudflare static assets.
# - No third party may be contacted except the public NBP rate endpoint (connect-src).
# - 'unsafe-inline' is allowed for styles only: React and the UI kit set inline style attributes.
#   Scripts are same-origin only (the theme bootstrap is a file, not an inline script).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.nbp.pl; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Content-hashed build output never changes under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must always be revalidated so a new release is picked up.
/index.html
  Cache-Control: no-cache
